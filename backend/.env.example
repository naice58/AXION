# Never commit a real .env file or API key to GitHub.
PORT=3000
NODE_ENV=development
# Create a PostgreSQL database on Render and paste its INTERNAL database URL here locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set this privately in Render Environment. Replace only after GasparzinhoPay gives you a real key.
GASPARZINHOPAY_API_KEY=gp_live_SUA_CHAVE_AQUI
GASPARZINHOPAY_BASE_URL=https://gasparzinhopay.com/api/v1
# Must be a long random secret. Only use this webhook check if the provider can send this header.
WEBHOOK_SECRET=troque-por-um-segredo-longo-aleatorio
# Optional: comma-separated trusted origins, e.g. https://SEUUSUARIO.github.io
CORS_ORIGINS=
